<idea-plugin>
    <id>dev.fatihdogmus.agenticreview</id>
    <name>Agentic Review</name>
    <version>1.1.0</version>
    <vendor>Internal</vendor>
    <description><![CDATA[
        <p>Agentic Review brings a lightweight, PR-style review workflow into IntelliJ IDEA without requiring a remote pull request.</p>
        <p>Its goal is to help you review uncommitted work, commits, commit ranges, or branch diffs inside the IDE, keep review comments as local workspace state, and hand unresolved work to coding agents in a structured way.</p>
        <p><b>How to use it:</b></p>
        <ul>
            <li>Open <b>Tools | Open Agentic Review</b> to start from your uncommitted changes.</li>
            <li>Use <b>Create Agentic Review</b> from the VCS Log to review one or more commits.</li>
            <li>Browse changed files, inspect diffs, and add inline review comments.</li>
            <li>Copy the generated agent prompt or use the bundled MCP toolset to pass open comments to an agent for implementation.</li>
        </ul>
        <p>Agentic Review is designed for local-first development workflows: self-review before commit, branch review before push, and agent-assisted follow-up on concrete review comments.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <diff.DiffExtension implementation="dev.fatihdogmus.agenticreview.diff.ReviewDiffExtension"/>
        <fileEditorProvider implementation="dev.fatihdogmus.agenticreview.editor.ReviewPageEditorProvider"/>
        <postStartupActivity implementation="dev.fatihdogmus.agenticreview.EnableMcpServerOnStartupActivity"/>
        <mcpServer.mcpToolset implementation="dev.fatihdogmus.agenticreview.mcp.ReviewMcpToolset"/>
        <notificationGroup id="Agentic Review" displayType="BALLOON" isLogByDefault="false"/>
        <toolWindow id="Agentic Review" anchor="left" secondary="true"
                    factoryClass="dev.fatihdogmus.agenticreview.ReviewStripeToolWindowFactory"/>
    </extensions>

    <actions>
        <action
                id="AgenticReview.OpenReviewDialog"
                class="dev.fatihdogmus.agenticreview.actions.OpenReviewDialogAction"
                text="Open Agentic Review">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift alt P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift P"/>
        </action>
        <action
                id="AgenticReview.StartReviewFromGitLog"
                class="dev.fatihdogmus.agenticreview.actions.StartReviewFromGitLogAction"
                text="Create Agentic Review">
            <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last"/>
            <add-to-group group-id="Vcs.Log.Toolbar.RightCorner" anchor="last"/>
        </action>
        <action
                id="AgenticReview.AddComment"
                class="dev.fatihdogmus.agenticreview.actions.AddReviewCommentAction"
                text="Add Review Comment">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="AgenticReview.OpenReviewedFile"
                class="dev.fatihdogmus.agenticreview.actions.OpenReviewedFileAction"
                text="Go to File">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
